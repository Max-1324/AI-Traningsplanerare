# Kopiera till .env och fyll i. Bara de två första raderna plus en AI-nyckel krävs.

# ── intervals.icu (krävs) ─────────────────────────────────────────────────────
INTERVALS_ATHLETE_ID=i12345
INTERVALS_API_KEY=

# ── Planeringsmotor ───────────────────────────────────────────────────────────
# deterministic: koden planerar belastningen, AI berikar (standard). legacy: gamla AI-pipelinen.
PLANNER_ENGINE=deterministic
# off = ingen AI alls (planen fungerar ändå)
PLANNER_AI=on
# Dagar framåt med konkreta pass (9 = idag + 9 dagar)
DETAIL_HORIZON_DAYS=9
# Språk för AI-texter (beskrivningar, sammanfattning, feedback)
COACH_LANGUAGE=English
# Skriv veckomålen som TARGET-event i intervals.icu (bara veckor utan egna mål/årsplan)
SYNC_WEEK_TARGETS=on

# ── Belastning och periodisering ──────────────────────────────────────────────
TARGET_CTL=85
RAMP_CTL_PER_WEEK=4.0
RAMP_CTL_MAX=6.0
# Deloadvecka: daglig belastning som andel av CTL
DELOAD_LOAD_FACTOR=0.70
# Tak för hårda pass per vecka (0-3). Utan värde anpassas antalet efter återhämtningen (normalt 2).
# KEY_SESSIONS_PER_WEEK=2
# Styrkepass per vecka utan styrkemål i årsplanen. Utan värde: 2 i basperioder, 1 mot ett mål.
# STRENGTH_PER_WEEK=2
# bodyweight (standard) eller heavy (gym)
# STRENGTH_STYLE=bodyweight
SECONDARY_SESSIONS_PER_WEEK=1
# Flera idrotter (används när årsplanen bara har totaltid per vecka)
# Årsplanens mål för den här sporten = total tid för alla idrotter (plan builder kräver en sport)
# ATP_TOTAL_SPORT=Ride
# BASE_MIX=cycling:0.6,Run:0.25,ski:0.15
# FOCUS_SHARE=0.65
# SPORT_MIN_SESSIONS=Run:2,cycling:2,ski:1
# ON_DEMAND_SPORTS=Swim
# SNOW_MONTHS=12,1,2,3
LONG_SESSION_SHARE=0.35
WEEKDAY_MAX_MIN=120
# Lägsta temperatur (°C) för cykling utomhus. Vintern styrs enklast med en anteckning "Ej: utomhuscykel".
# OUTDOOR_MIN_TEMP_C=5
CATCH_UP_CAP=1.15
RISK_TOLERANCE=NORMAL

# ── Sporter ───────────────────────────────────────────────────────────────────
# Tomt = alla i katalogen. Styrka och vila ingår alltid.
AVAILABLE_SPORTS=Ride,VirtualRide,RollerSki,NordicSki,Run
# DEFAULT_SPORT=Ride
# FALLBACK_SPORT=VirtualRide
POWER_SPORTS=VirtualRide
MIN_BUDGET_RUN_MIN=60
MIN_BUDGET_ROLLERSKI_MIN=90
MAX_ROLLSKI_PER_WEEK=1
MAX_STRENGTH_PER_PLAN=3
MIN_STRENGTH_GAP_DAYS=2

# ── Plats och väder (met.no) ──────────────────────────────────────────────────
ATHLETE_LAT=59.3793
ATHLETE_LON=13.5036
ATHLETE_LOCATION=Karlstad
CONTACT_EMAIL=din.epost@exempel.se

# ── AI-leverantör (en räcker) ─────────────────────────────────────────────────
AI_PROVIDER=gemini
# AI_PROVIDER_PIPELINE=gemini
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=http://localhost:8081/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5
ANTHROPIC_MAX_TOKENS=16000
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile
# OLLAMA_MODEL=qwen3:14b
OLLAMA_NUM_PREDICT=16384
# OLLAMA_THINK=off
AI_MIN_REQUEST_INTERVAL_SEC=6.0
PLAN_ENRICH_TEMPERATURE=0.3

# ── Legacy-pipelinen (bara PLANNER_ENGINE=legacy) ─────────────────────────────
PLAN_CANDIDATE_COUNT=3
PLAN_REVIEW_MAX_ITERATIONS=5

# ── Webhook-server ────────────────────────────────────────────────────────────
WEBHOOK_SECRET=
GENERATOR_TIMEOUT_SEC=900

LOG_LEVEL=INFO
